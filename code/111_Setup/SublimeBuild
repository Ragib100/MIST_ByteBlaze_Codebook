{
  "working_dir": "${file_path}",
  "selector": "source.c++, source.cpp",
  "shell": true,

  "windows": {
    "shell_cmd": "g++ -std=c++17 -O2 -Wall \"${file}\" -o \"${file_base_name}.exe\" && \"${file_base_name}.exe\" < in.txt > out.txt 2> error.txt"
  },
  
  "linux": {
    "shell_cmd": "g++ -std=c++17 -O2 -Wall \"${file}\" -o \"${file_base_name}\" && \"./${file_base_name}\" < in.txt > out.txt 2> error.txt"
  }
}
